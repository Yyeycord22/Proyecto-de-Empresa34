<!-- MODAL DE EDICIÓN DE FOTOGRAFÍA -->
<div id="admin-edit-modal" style="display:none; position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.85); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px); align-items:center; justify-content:center; padding:1.5rem;">
  <div style="background:var(--gray-1); border:1px solid rgba(255,255,255,0.15); border-radius:4px; max-width:550px; width:100%; padding:1.75rem; box-shadow:0 24px 60px rgba(0,0,0,0.85);">
    <h3 style="font-size:1.15rem; margin-bottom:1.25rem; color:var(--yellow);">✏ Editar Metadatos de Fotografía</h3>
    <form id="edit-photo-form">
      <input type="hidden" id="edit-photo-id" value="" />
      <div class="form-group">
        <label class="form-label" for="edit-photo-title">Título del Proyecto</label>
        <input class="form-input" id="edit-photo-title" type="text" required />
      </div>
      <div class="form-group">
        <label class="form-label" for="edit-photo-category">Categoría Asignada</label>
        <select class="form-select" id="edit-photo-category" required></select>
      </div>
      <div class="form-group">
        <label class="form-label" for="edit-photo-alt">Texto Alternativo (SEO & Accesibilidad)</label>
        <input class="form-input" id="edit-photo-alt" type="text" required />
      </div>
      <div class="form-group">
        <label class="form-label" for="edit-photo-size">Formato Bauhaus en Cuadrícula</label>
        <select class="form-select" id="edit-photo-size">
          <option value="">Normal (1 columna × 1 fila)</option>
          <option value="portfolio__item--wide">Panorámico ancho (2 columnas × 1 fila)</option>
          <option value="portfolio__item--tall">Vertical alto (1 columna × 2 filas)</option>
        </select>
      </div>
      <div style="display:flex; justify-content:flex-end; gap:0.75rem; margin-top:1.5rem;">
        <button type="button" class="btn-admin btn-admin--outline" id="edit-photo-cancel">Cancelar</button>
        <button type="submit" class="btn-admin btn-admin--red">Guardar Cambios</button>
      </div>
    </form>
  </div>
</div>

<script>
  /* ============================================================
     INTEGRACIÓN CON SUPABASE (CRUD REAL Y PERSISTENCIA PERMANENTE)
     ============================================================ */
  import {
    isSupabaseConfigured,
    getSupabaseCredentials,
    getCategories,
    createCategory,
    updateCategory,
    deleteCategory,
    getPortfolio,
    createPortfolioItem,
    updatePortfolioItem,
    deletePortfolioItem,
    uploadPortfolioImage,
    getSettings,
    saveAllSettings,
    type Category,
    type PortfolioItem
  } from '../../lib/supabase';

  /* ============================================================
     1. GESTIÓN DE AUTENTICACIÓN (Usuario: administrador / Contraseña: 3344K)
     ============================================================ */
  const AUTH_USER = 'administrador';
  const AUTH_PASS = '3344K';

  const authGate = document.getElementById('auth-gate');
  const dashboardRoot = document.getElementById('admin-dashboard-root');
  const loginForm = document.getElementById('admin-login-form');
  const loginErrorMsg = document.getElementById('login-error-msg');
  const logoutBtn = document.getElementById('logout-btn');

  function checkAuth() {
    const isAuth = sessionStorage.getItem('haus_admin_authenticated') === 'true';
    if (isAuth) {
      if (authGate) authGate.style.display = 'none';
      if (dashboardRoot) dashboardRoot.style.display = 'flex';
      initDashboard();
    } else {
      if (authGate) authGate.style.display = 'flex';
      if (dashboardRoot) dashboardRoot.style.display = 'none';
    }
  }

  loginForm?.addEventListener('submit', function (e) {
    e.preventDefault();
    const user = (document.getElementById('login-username') as HTMLInputElement)?.value.trim();
    const pass = (document.getElementById('login-password') as HTMLInputElement)?.value.trim();

    if (user === AUTH_USER && pass === AUTH_PASS) {
      sessionStorage.setItem('haus_admin_authenticated', 'true');
      if (loginErrorMsg) loginErrorMsg.style.display = 'none';
      checkAuth();
    } else {
      if (loginErrorMsg) {
        loginErrorMsg.style.display = 'block';
        loginErrorMsg.textContent = 'Usuario o contraseña incorrectos. Ingrese las credenciales autorizadas.';
      }
    }
  });

  logoutBtn?.addEventListener('click', function () {
    if (confirm('¿Deseas cerrar la sesión de administración?')) {
      sessionStorage.removeItem('haus_admin_authenticated');
      checkAuth();
    }
  });

  /* ============================================================
     2. NAVEGACIÓN ENTRE PANELES
     ============================================================ */
  function showPanel(id: string) {
    document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.sidebar__link').forEach(l => l.classList.remove('active'));
    const targetPanel = document.getElementById('panel-' + id);
    const targetNav = document.getElementById('nav-' + id);
    if (targetPanel) targetPanel.classList.add('active');
    if (targetNav) targetNav.classList.add('active');
    const titles: Record<string, string> = {
      dashboard: 'Dashboard General',
      categorias: 'Gestión de Categorías',
      imagenes: 'Portafolio & Fotografías',
      subir: 'Añadir Nueva Foto',
      contacto: 'Contacto & Redes Oficiales',
      proyectos: 'Casos de Proyectos',
      servicios: 'Servicios Activos'
    };
    const titleEl = document.getElementById('panel-title');
    if (titleEl) titleEl.textContent = titles[id] || id;
  }

  // Asignar listeners a enlaces de navegación
  const navIds = ['dashboard', 'categorias', 'imagenes', 'subir', 'contacto', 'proyectos', 'servicios'];
  navIds.forEach(id => {
    document.getElementById('nav-' + id)?.addEventListener('click', () => showPanel(id));
  });

  document.getElementById('btn-goto-contact')?.addEventListener('click', () => showPanel('contacto'));
  document.getElementById('btn-goto-upload')?.addEventListener('click', () => showPanel('subir'));

  /* ============================================================
     3. VERIFICACIÓN Y ESTADO DE CONEXIÓN CON SUPABASE
     ============================================================ */
  function updateSupabaseStatusUI() {
    const statusBadge = document.getElementById('supabase-status-badge');
    const dashBadge = document.getElementById('dash-supabase-badge');
    const dashUrl = document.getElementById('dash-supabase-url');
    const creds = getSupabaseCredentials();
    const isConfigured = isSupabaseConfigured();

    if (dashUrl) {
      dashUrl.textContent = isConfigured ? creds.url : 'Modo Respaldo Local (Configura .env)';
    }

    if (isConfigured) {
      if (statusBadge) {
        statusBadge.textContent = 'Supabase: Conectado';
        statusBadge.style.background = '#25D366';
      }
      if (dashBadge) {
        dashBadge.className = 'badge badge--success';
        dashBadge.textContent = 'Activo & Conectado';
      }
    } else {
      if (statusBadge) {
        statusBadge.textContent = 'Supabase: .env Pendiente';
        statusBadge.style.background = 'var(--yellow)';
        statusBadge.style.color = '#111';
      }
      if (dashBadge) {
        dashBadge.className = 'badge badge--warn';
        dashBadge.textContent = 'Configurar credenciales';
      }
    }
  }

  document.getElementById('btn-config-supabase')?.addEventListener('click', () => {
    const creds = getSupabaseCredentials();
    const promptMsg = `Credenciales de Supabase actuales:\n\nURL: ${creds.url}\n\nPara modificarlas permanentemente, edita el archivo .env en la raíz del proyecto (PUBLIC_SUPABASE_URL y PUBLIC_SUPABASE_ANON_KEY).\n\n¿Deseas ingresar una URL y Key temporal para esta sesión?`;
    if (confirm(promptMsg)) {
      const newUrl = prompt('Ingresa tu PUBLIC_SUPABASE_URL:', creds.url);
      if (newUrl) {
        const newKey = prompt('Ingresa tu PUBLIC_SUPABASE_ANON_KEY:', creds.key);
        if (newKey) {
          localStorage.setItem('haus_supabase_url', newUrl.trim());
          localStorage.setItem('haus_supabase_key', newKey.trim());
          alert('¡Credenciales actualizadas en el cliente! Recargando...');
          window.location.reload();
        }
      }
    }
  });

  /* ============================================================
     4. GESTIÓN COMPLETA DE CATEGORÍAS (CRUD REAL)
     ============================================================ */
  let currentCategories: Category[] = [];

  async function loadAndRenderCategories() {
    currentCategories = await getCategories();
    renderCategoriesTable();
    populateCategoryDropdown();
    const statCat = document.getElementById('stat-categories-count');
    if (statCat) statCat.textContent = String(currentCategories.length);
  }

  function renderCategoriesTable() {
    const tbody = document.getElementById('categories-table-body');
    if (!tbody) return;
    tbody.innerHTML = '';
    currentCategories.forEach((cat) => {
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td><code>${cat.key}</code></td>
        <td><strong>${cat.label}</strong></td>
        <td>${cat.desc || '—'}</td>
        <td style="display:flex; gap:0.5rem;">
          <button class="btn-admin btn-admin--blue cat-edit-btn" style="padding:0.3rem 0.65rem;font-size:0.75rem" data-key="${cat.key}">Editar</button>
          <button class="btn-admin btn-admin--danger cat-del-btn" data-key="${cat.key}">Eliminar</button>
        </td>
      `;
      tbody.appendChild(tr);
    });

    // Conectar eventos de edición y eliminación
    tbody.querySelectorAll('.cat-edit-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const key = (e.currentTarget as HTMLElement).dataset.key;
        if (key) onEditCategory(key);
      });
    });

    tbody.querySelectorAll('.cat-del-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const key = (e.currentTarget as HTMLElement).dataset.key;
        if (key) onDeleteCategory(key);
      });
    });
  }

  function populateCategoryDropdown() {
    const select = document.getElementById('img-category-select') as HTMLSelectElement;
    if (!select) return;
    select.innerHTML = '<option value="">— Seleccionar categoría —</option>';
    currentCategories.forEach(cat => {
      const opt = document.createElement('option');
      opt.value = cat.key;
      opt.textContent = cat.label;
      select.appendChild(opt);
    });
  }

  function onEditCategory(key: string) {
    const cat = currentCategories.find(c => c.key === key);
    if (!cat) return;
    const origKeyInput = document.getElementById('cat-original-key') as HTMLInputElement;
    const nameInput = document.getElementById('cat-name') as HTMLInputElement;
    const slugInput = document.getElementById('cat-slug') as HTMLInputElement;
    const descInput = document.getElementById('cat-desc') as HTMLInputElement;
    const titleEl = document.getElementById('cat-form-title');
    const submitBtn = document.getElementById('cat-submit-btn');
    const cancelBtn = document.getElementById('cat-cancel-btn');

    if (origKeyInput) origKeyInput.value = cat.key;
    if (nameInput) nameInput.value = cat.label;
    if (slugInput) slugInput.value = cat.key;
    if (descInput) descInput.value = cat.desc || '';
    if (titleEl) titleEl.textContent = '✏ Editando Categoría: ' + cat.label;
    if (submitBtn) submitBtn.textContent = 'Actualizar en Base de Datos';
    if (cancelBtn) cancelBtn.style.display = 'inline-block';
    nameInput?.focus();
  }

  function resetCategoryForm() {
    const origKeyInput = document.getElementById('cat-original-key') as HTMLInputElement;
    const nameInput = document.getElementById('cat-name') as HTMLInputElement;
    const slugInput = document.getElementById('cat-slug') as HTMLInputElement;
    const descInput = document.getElementById('cat-desc') as HTMLInputElement;
    const titleEl = document.getElementById('cat-form-title');
    const submitBtn = document.getElementById('cat-submit-btn');
    const cancelBtn = document.getElementById('cat-cancel-btn');

    if (origKeyInput) origKeyInput.value = '';
    if (nameInput) nameInput.value = '';
    if (slugInput) slugInput.value = '';
    if (descInput) descInput.value = '';
    if (titleEl) titleEl.textContent = '+ Crear Nueva Categoría';
    if (submitBtn) submitBtn.textContent = 'Guardar en Base de Datos';
    if (cancelBtn) cancelBtn.style.display = 'none';
  }

  document.getElementById('cat-cancel-btn')?.addEventListener('click', resetCategoryForm);

  async function onDeleteCategory(key: string) {
    const cat = currentCategories.find(c => c.key === key);
    if (!cat) return;
    if (confirm(`¿Estás seguro de eliminar la categoría "${cat.label}" de la base de datos?`)) {
      const res = await deleteCategory(key);
      if (res.success) {
        alert('Categoría eliminada con éxito de la base de datos.');
        await loadAndRenderCategories();
      } else {
        alert('Aviso: ' + (res.error || 'No se pudo eliminar en Supabase.'));
      }
    }
  }

  const catForm = document.getElementById('category-form');
  catForm?.addEventListener('submit', async function (e) {
    e.preventDefault();
    const origKey = (document.getElementById('cat-original-key') as HTMLInputElement)?.value.trim();
    const name = (document.getElementById('cat-name') as HTMLInputElement)?.value.trim();
    const slug = (document.getElementById('cat-slug') as HTMLInputElement)?.value.trim().toLowerCase().replace(/\s+/g, '-');
    const desc = (document.getElementById('cat-desc') as HTMLInputElement)?.value.trim();

    if (!name || !slug) {
      alert('El nombre y el identificador (slug) son obligatorios.');
      return;
    }

    const submitBtn = document.getElementById('cat-submit-btn') as HTMLButtonElement;
    if (submitBtn) submitBtn.disabled = true;

    if (!isSupabaseConfigured()) {
      if (submitBtn) submitBtn.disabled = false;
      alert('⚠️ Supabase no está configurado.\nPor favor agrega PUBLIC_SUPABASE_URL y PUBLIC_SUPABASE_ANON_KEY en tu archivo .env y reconstruye el proyecto.');
      return;
    }

    try {
      if (origKey) {
        // Actualizar categoría existente
        const res = await updateCategory(origKey, { key: slug, label: name, desc });
        if (res.success) {
          alert('✅ ¡Categoría actualizada exitosamente en la base de datos!');
        } else {
          alert('❌ Error al actualizar categoría:\n' + (res.error || 'Error desconocido en Supabase.'));
        }
      } else {
        // Crear nueva categoría
        const res = await createCategory({ key: slug, label: name, desc });
        if (res.success) {
          alert('✅ ¡Nueva categoría guardada con éxito en la base de datos!');
        } else {
          alert('❌ Error al crear categoría:\n' + (res.error || 'Error desconocido en Supabase.'));
        }
      }
    } catch (err: any) {
      alert('❌ Error inesperado:\n' + (err?.message || String(err)));
    }

    if (submitBtn) submitBtn.disabled = false;
    resetCategoryForm();
    await loadAndRenderCategories();
  });

  /* ============================================================
     5. GESTIÓN COMPLETA DEL PORTAFOLIO (CRUD REAL EN SUPABASE)
     ============================================================ */
  let currentPortfolio: PortfolioItem[] = [];

  async function loadAndRenderPortfolio() {
    currentPortfolio = await getPortfolio();
    renderAdminPortfolioGrid();
    const badge = document.getElementById('portfolio-total-badge');
    const statImages = document.getElementById('stat-images-count');
    if (badge) badge.textContent = String(currentPortfolio.length);
    if (statImages) statImages.textContent = String(currentPortfolio.length);
  }

  function renderAdminPortfolioGrid() {
    const grid = document.getElementById('admin-portfolio-grid');
    if (!grid) return;
    grid.innerHTML = '';

    if (currentPortfolio.length === 0) {
      grid.innerHTML = `
        <div style="grid-column: 1 / -1; text-align: center; padding: 3rem 1.5rem; background: rgba(255,255,255,0.02); border: 1px dashed rgba(255,255,255,0.12); border-radius: 8px;">
          <p style="color: var(--color-gray-medium); font-size: 1.05rem; margin-bottom: 0.5rem; font-weight: 500;">No hay fotografías registradas en la base de datos de Supabase.</p>
          <p style="color: var(--color-gray-medium); font-size: 0.85rem; opacity: 0.75;">Utiliza el formulario superior para subir o agregar nuevas imágenes al catálogo.</p>
        </div>
      `;
      return;
    }

    currentPortfolio.forEach((item) => {
      const div = document.createElement('div');
      div.className = 'img-thumb';
      div.dataset.id = item.id;

      const formatLabel = item.sizeClass === 'portfolio__item--wide' ? 'Panorámico (2×1)' : (item.sizeClass === 'portfolio__item--tall' ? 'Vertical (1×2)' : 'Normal (1×1)');

      div.innerHTML = `
        <div class="img-thumb__media">
          <img src="${item.image}" alt="${item.alt}" loading="lazy" />
          <span class="img-thumb__cat">${item.categoryLabel || item.category}</span>
          <span class="img-thumb__format">${formatLabel}</span>
        </div>
        <div class="img-thumb__body">
          <h4 class="img-thumb__title" title="${item.title || item.alt}">${item.title || 'Fotografía de Catálogo'}</h4>
          <p class="img-thumb__alt" title="${item.alt}">${item.alt || 'Sin descripción'}</p>
        </div>
        <div class="img-thumb__actions">
          <button type="button" class="btn-admin btn-admin--outline port-prev-btn" data-id="${item.id}">Ver</button>
          <button type="button" class="btn-admin btn-admin--blue port-edit-btn" data-id="${item.id}">Editar</button>
          <button type="button" class="btn-admin btn-admin--danger port-del-btn" data-id="${item.id}">Eliminar</button>
        </div>
      `;
      grid.appendChild(div);
    });

    // Eventos: Previsualizar
    grid.querySelectorAll('.port-prev-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id;
        const item = currentPortfolio.find(p => p.id === id);
        if (!item) return;
        const modal = document.getElementById('admin-preview-modal');
        const img = document.getElementById('prev-modal-img') as HTMLImageElement;
        const title = document.getElementById('prev-modal-title');
        const cat = document.getElementById('prev-modal-cat');
        const format = document.getElementById('prev-modal-format');
        const alt = document.getElementById('prev-modal-alt');

        if (img) img.src = item.image;
        if (title) title.textContent = item.title || 'Previsualización de Fotografía';
        if (cat) cat.textContent = 'Categoría: ' + (item.categoryLabel || item.category);
        if (format) format.textContent = 'Formato: ' + (item.sizeClass === 'portfolio__item--wide' ? 'Panorámico (2×1)' : (item.sizeClass === 'portfolio__item--tall' ? 'Vertical (1×2)' : 'Normal (1×1)'));
        if (alt) alt.textContent = 'Texto Alt (SEO): ' + item.alt;

        if (modal) modal.style.display = 'flex';
      });
    });

    // Eventos: Editar
    grid.querySelectorAll('.port-edit-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id;
        const item = currentPortfolio.find(p => p.id === id);
        if (!item) return;

        const modal = document.getElementById('admin-edit-modal');
        const idInput = document.getElementById('edit-photo-id') as HTMLInputElement;
        const titleInput = document.getElementById('edit-photo-title') as HTMLInputElement;
        const catSelect = document.getElementById('edit-photo-category') as HTMLSelectElement;
        const altInput = document.getElementById('edit-photo-alt') as HTMLInputElement;
        const sizeSelect = document.getElementById('edit-photo-size') as HTMLSelectElement;

        if (catSelect) {
          catSelect.innerHTML = '';
          currentCategories.forEach(c => {
            const opt = document.createElement('option');
            opt.value = c.key;
            opt.textContent = c.label;
            if (c.key === item.category) opt.selected = true;
            catSelect.appendChild(opt);
          });
        }

        if (idInput) idInput.value = item.id;
        if (titleInput) titleInput.value = item.title || '';
        if (altInput) altInput.value = item.alt || '';
        if (sizeSelect) sizeSelect.value = item.sizeClass || '';

        if (modal) modal.style.display = 'flex';
      });
    });

    // Eventos: Eliminar (Persistencia Real en Supabase)
    grid.querySelectorAll('.port-del-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const button = e.currentTarget as HTMLButtonElement;
        const id = button.dataset.id;
        if (!id) return;

        if (confirm('¿Deseas eliminar permanentemente esta fotografía de la base de datos de Supabase?')) {
          const originalText = button.textContent;
          button.disabled = true;
          button.textContent = 'Eliminando...';
          button.style.opacity = '0.6';
          button.style.cursor = 'wait';

          try {
            const res = await deletePortfolioItem(id);
            if (res.success) {
              const card = button.closest('.img-thumb') as HTMLElement | null;
              if (card) {
                card.style.transition = 'all 0.3s cubic-bezier(0.4, 0, 0.2, 1)';
                card.style.opacity = '0';
                card.style.transform = 'scale(0.85)';
              }
              alert('✅ Fotografía eliminada exitosamente de la base de datos de Supabase.');
              await loadAndRenderPortfolio();
            } else {
              button.disabled = false;
              button.textContent = originalText;
              button.style.opacity = '1';
              button.style.cursor = 'pointer';
              alert('❌ Error al eliminar de la base de datos:\n' + (res.error || 'Error desconocido en Supabase.'));
            }
          } catch (err: any) {
            button.disabled = false;
            button.textContent = originalText;
            button.style.opacity = '1';
            button.style.cursor = 'pointer';
            alert('❌ Error inesperado al eliminar fotografía:\n' + (err?.message || String(err)));
          }
        }
      });
    });
  }

  // Cerrar modal de previsualización
  document.getElementById('prev-modal-close')?.addEventListener('click', () => {
    const modal = document.getElementById('admin-preview-modal');
    if (modal) modal.style.display = 'none';
  });

  // Cancelar modal de edición
  document.getElementById('edit-photo-cancel')?.addEventListener('click', () => {
    const modal = document.getElementById('admin-edit-modal');
    if (modal) modal.style.display = 'none';
  });

  // Guardar edición de fotografía
  document.getElementById('edit-photo-form')?.addEventListener('submit', async function (e) {
    e.preventDefault();
    const id = (document.getElementById('edit-photo-id') as HTMLInputElement)?.value;
    const title = (document.getElementById('edit-photo-title') as HTMLInputElement)?.value.trim();
    const category = (document.getElementById('edit-photo-category') as HTMLSelectElement)?.value;
    const alt = (document.getElementById('edit-photo-alt') as HTMLInputElement)?.value.trim();
    const sizeClass = (document.getElementById('edit-photo-size') as HTMLSelectElement)?.value;

    const catObj = currentCategories.find(c => c.key === category);
    const categoryLabel = catObj ? catObj.label : category;

    try {
      const res = await updatePortfolioItem(id, {
        title,
        category,
        categoryLabel,
        alt,
        sizeClass
      });
      if (res.success) {
        alert('✅ ¡Fotografía actualizada exitosamente en la base de datos!');
      } else {
        alert('❌ Error al actualizar fotografía:\n' + (res.error || 'Error desconocido en Supabase.'));
      }
    } catch (err: any) {
      alert('❌ Error inesperado al editar fotografía:\n' + (err?.message || String(err)));
    }

    const modal = document.getElementById('admin-edit-modal');
    if (modal) modal.style.display = 'none';
    await loadAndRenderPortfolio();
  });

  /* ============================================================
     6. SUBIDA DE NUEVAS FOTOGRAFÍAS (SUPABASE STORAGE & TABLE)
     ============================================================ */
  const fileInput = document.getElementById('img-file') as HTMLInputElement;
  const previewDiv = document.getElementById('img-preview');
  const previewImg = document.getElementById('img-preview-src') as HTMLImageElement;
  const pathInput = document.getElementById('img-path') as HTMLInputElement;
  let selectedFile: File | null = null;
  let loadedFileDataUrl = '';

  fileInput?.addEventListener('change', function () {
    const file = this.files?.[0];
    if (!file) return;
    selectedFile = file;
    if (pathInput && !pathInput.value) {
      pathInput.value = file.name;
    }
    const reader = new FileReader();
    reader.onload = e => {
      loadedFileDataUrl = e.target?.result as string;
      if (previewDiv && previewImg) {
        previewDiv.style.display = 'block';
        previewImg.src = loadedFileDataUrl;
      }
    };
    reader.readAsDataURL(file);
  });

  const zone = document.getElementById('upload-zone');
  if (zone) {
    ['dragenter', 'dragover'].forEach(ev => {
      zone.addEventListener(ev, e => { e.preventDefault(); zone.classList.add('drag-over'); });
    });
    ['dragleave', 'drop'].forEach(ev => {
      zone.addEventListener(ev, e => { e.preventDefault(); zone.classList.remove('drag-over'); });
    });
    zone.addEventListener('drop', (e: DragEvent) => {
      const file = e.dataTransfer?.files?.[0];
      if (file && file.type.startsWith('image/')) {
        const dt = new DataTransfer();
        dt.items.add(file);
        if (fileInput) {
          fileInput.files = dt.files;
          fileInput.dispatchEvent(new Event('change'));
        }
      }
    });
  }

  const uploadForm = document.getElementById('upload-form');
  uploadForm?.addEventListener('submit', async function (e) {
    e.preventDefault();
    const name = (document.getElementById('img-name') as HTMLInputElement)?.value.trim();
    const cat = (document.getElementById('img-category-select') as HTMLSelectElement)?.value;
    const alt = (document.getElementById('img-alt') as HTMLInputElement)?.value.trim();
    const size = (document.getElementById('img-size') as HTMLSelectElement)?.value;
    const customPath = (document.getElementById('img-path') as HTMLInputElement)?.value.trim();

    if (!name || !cat || !alt) {
      alert('Por favor completa todos los campos requeridos (Título, Categoría y Texto Alt).');
      return;
    }

    const submitBtn = document.getElementById('upload-submit-btn') as HTMLButtonElement;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Guardando en Base de Datos...';
    }

    if (!isSupabaseConfigured()) {
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Guardar y Publicar en Base de Datos →'; }
      alert('⚠️ Supabase no está configurado.\nPor favor agrega PUBLIC_SUPABASE_URL y PUBLIC_SUPABASE_ANON_KEY en tu archivo .env y reconstruye el proyecto.\n\nSin Supabase, las imágenes no se pueden persistir de forma permanente.');
      return;
    }

    let finalImageUrl = '';

    // 1. Si se seleccionó un archivo, subirlo físicamente a Supabase Storage
    if (selectedFile) {
      if (submitBtn) submitBtn.textContent = 'Subiendo imagen a Supabase Storage...';
      const uploadRes = await uploadPortfolioImage(selectedFile);
      if (uploadRes.error) {
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Guardar y Publicar en Base de Datos →'; }
        alert('❌ Error al subir la imagen al Storage de Supabase:\n' + uploadRes.error + '\n\nVerifica que el bucket "portfolio" esté creado y sea público (ejecuta supabase-setup.sql).');
        return;
      }
      finalImageUrl = uploadRes.url || '';
    }

    // 2. Si no hubo archivo directo, usar la ruta o URL especificada
    if (!finalImageUrl) {
      if (customPath) {
        finalImageUrl = customPath.startsWith('/') || customPath.startsWith('http') ? customPath : `/imagenes/${customPath}`;
      } else {
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Guardar y Publicar en Base de Datos →'; }
        alert('Por favor selecciona una imagen o ingresa una ruta válida.');
        return;
      }
    }

    const catObj = currentCategories.find(c => c.key === cat);
    const categoryLabel = catObj ? catObj.label : cat;
    const newId = 'p_' + Date.now();

    const newItem: PortfolioItem = {
      id: newId,
      category: cat,
      categoryLabel: categoryLabel,
      image: finalImageUrl,
      alt: alt,
      sizeClass: size || '',
      title: name
    };

    // 3. Guardar registro permanente en Supabase DB (tabla portfolio)
    if (submitBtn) submitBtn.textContent = 'Guardando metadatos en base de datos...';
    try {
      const res = await createPortfolioItem(newItem);
      if (!res.success) {
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Guardar y Publicar en Base de Datos →'; }
        alert('❌ Error al guardar en la base de datos de Supabase:\n' + (res.error || 'Error desconocido.') + '\n\nVerifica que la tabla "portfolio" exista (ejecuta supabase-setup.sql).');
        return;
      }
    } catch (err: any) {
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Guardar y Publicar en Base de Datos →'; }
      alert('❌ Error inesperado al insertar en la base de datos:\n' + (err?.message || String(err)));
      return;
    }

    alert('✅ ¡Fotografía guardada con éxito en la base de datos!\nLos cambios se reflejarán automáticamente en el portafolio público al recargar la página.');

    // 4. Limpiar formulario y refrescar
    if (uploadForm instanceof HTMLFormElement) uploadForm.reset();
    selectedFile = null;
    loadedFileDataUrl = '';
    if (previewDiv) previewDiv.style.display = 'none';
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Guardar y Publicar en Base de Datos →';
    }

    await loadAndRenderPortfolio();
    showPanel('imagenes');
  });

  /* ============================================================
     7. CONFIGURACIÓN DE CONTACTO Y REDES
     ============================================================ */
  async function loadContactSettings() {
    const cfg = await getSettings();
    const waInput = document.getElementById('cfg-whatsapp') as HTMLInputElement;
    const phoneInput = document.getElementById('cfg-phone') as HTMLInputElement;
    const instaInput = document.getElementById('cfg-instagram') as HTMLInputElement;
    const addrInput = document.getElementById('cfg-address') as HTMLInputElement;
    const hoursInput = document.getElementById('cfg-hours') as HTMLInputElement;

    const dashWa = document.getElementById('dash-whatsapp-val');
    const dashInsta = document.getElementById('dash-instagram-val');

    if (cfg.whatsapp) {
      if (waInput) waInput.value = cfg.whatsapp;
      if (dashWa) dashWa.textContent = cfg.whatsapp;
    }
    if (cfg.phone && phoneInput) phoneInput.value = cfg.phone;
    if (cfg.instagram) {
      if (instaInput) instaInput.value = cfg.instagram;
      if (dashInsta) dashInsta.textContent = cfg.instagram;
    }
    if (cfg.address && addrInput) addrInput.value = cfg.address;
    if (cfg.hours && hoursInput) hoursInput.value = cfg.hours;
  }

  const contactForm = document.getElementById('contact-settings-form');
  contactForm?.addEventListener('submit', async function (e) {
    e.preventDefault();
    const submitBtn = contactForm.querySelector('button[type="submit"]') as HTMLButtonElement;
    const rawWa = (document.getElementById('cfg-whatsapp') as HTMLInputElement)?.value.trim() || '';
    const wa = rawWa.replace(/\D/g, '');
    const phone = (document.getElementById('cfg-phone') as HTMLInputElement)?.value.trim();
    const insta = (document.getElementById('cfg-instagram') as HTMLInputElement)?.value.trim();
    const address = (document.getElementById('cfg-address') as HTMLInputElement)?.value.trim();
    const hours = (document.getElementById('cfg-hours') as HTMLInputElement)?.value.trim();

    if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Guardando en base de datos...'; }

    if (!isSupabaseConfigured()) {
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Guardar y Actualizar Configuración'; }
      alert('⚠️ Supabase no está configurado.\nPor favor agrega PUBLIC_SUPABASE_URL y PUBLIC_SUPABASE_ANON_KEY en tu archivo .env y reconstruye el proyecto.');
      return;
    }

    try {
      const res = await saveAllSettings({ whatsapp: wa, phone, instagram: insta, address, hours });

      if (!res.success) {
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Guardar y Actualizar Configuración'; }
        alert('❌ Error al guardar en Supabase:\n' + (res.error || 'Error desconocido. Revisa la consola del navegador.'));
        return;
      }

      const dashWa = document.getElementById('dash-whatsapp-val');
      const dashInsta = document.getElementById('dash-instagram-val');
      if (dashWa) dashWa.textContent = wa;
      if (dashInsta) dashInsta.textContent = insta;

      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Guardar y Actualizar Configuración'; }
      alert('✅ ¡Configuración de contacto guardada permanentemente en la base de datos!\nLos cambios se reflejarán de inmediato en toda la web al recargar.');
    } catch (err: any) {
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Guardar y Actualizar Configuración'; }
      alert('❌ Error inesperado al guardar configuración:\n' + (err?.message || String(err)));
    }
  });

  document.getElementById('btn-save-project')?.addEventListener('click', () => {
    alert('Ficha de proyecto guardada satisfactoriamente en el registro.');
  });

  // Inicializar todo el panel
  function initDashboard() {
    updateSupabaseStatusUI();
    loadAndRenderCategories();
    loadAndRenderPortfolio();
    loadContactSettings();
  }

  checkAuth();
</script>
</body>
</html>
