---
// src/components/Portfolio.astro
import { portfolioItems, portfolioFilters } from '../data/projects';
---

<section class="portfolio" id="portafolio" aria-labelledby="portfolio-title">
  <div class="container">
    <div class="portfolio__head reveal">
      <div>
        <span class="label label--light">PORTAFOLIO</span>
        <h2 class="portfolio__title" id="portfolio-title">Nuestro trabajo en imágenes.</h2>
      </div>
      <div class="portfolio__filters" role="group" aria-label="Filtros de portafolio">
        {portfolioFilters.map((filter, idx) => (
          <button 
            class={`filter-btn ${idx === 0 ? 'active' : ''}`} 
            data-filter={filter.key} 
            id={`filter-${filter.key}`}
          >
            {filter.label}
          </button>
        ))}
      </div>
    </div>

    <div class="portfolio__grid" id="portfolio-grid" aria-live="polite">
      {portfolioItems.map((item) => (
        <div 
          class={`portfolio__item ${item.sizeClass || ''}`} 
          data-category={item.category} 
          data-img={item.image} 
          data-alt={item.alt} 
          tabindex="0" 
          role="button" 
          aria-label={`Ver fotografía: ${item.alt}`}
        >
          <img src={item.image} alt={item.alt} loading="lazy" />
          <div class="portfolio__item-overlay">
            <span>{item.categoryLabel}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="portfolio__geo" aria-hidden="true">
      <div class="portfolio__geo-circle"></div>
      <div class="portfolio__geo-rect"></div>
    </div>
  </div>

  <!-- Lightbox Modal -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Visor de imagen" aria-hidden="true">
    <button class="lightbox__close" id="lightbox-close" aria-label="Cerrar visor">&times;</button>
    <button class="lightbox__prev" id="lightbox-prev" aria-label="Imagen anterior">&#8592;</button>
    <button class="lightbox__next" id="lightbox-next" aria-label="Siguiente imagen">&#8594;</button>
    <div class="lightbox__content">
      <img src="" alt="" class="lightbox__img" id="lightbox-img" />
      <p class="lightbox__caption" id="lightbox-caption"></p>
    </div>
  </div>
</section>
