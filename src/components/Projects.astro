---
// src/components/Projects.astro
import { projectSteps } from '../data/projects';
import { WHATSAPP_NUMBER } from '../data/services';

const waLink = `https://wa.me/${WHATSAPP_NUMBER}?text=Hola%2C%20quisiera%20consultar%20sobre%20un%20proyecto%20similar.`;
---

<section class="projects" id="proyectos" aria-labelledby="projects-title">
  <div class="container">
    <div class="section-head reveal">
      <span class="label">PROYECTOS Y RESULTADOS</span>
      <h2 class="section-head__title" id="projects-title">Cómo trabajamos contigo.</h2>
    </div>
    
    <div class="projects__steps reveal">
      {projectSteps.map((step) => (
        <div class="project-step">
          <span class="project-step__num" style={`color:${step.numberColor}`}>
            {step.number}
          </span>
          <h3 class="project-step__title">{step.title}</h3>
          <p class="project-step__desc">{step.description}</p>
        </div>
      ))}
    </div>

    <div class="projects__cta reveal">
      <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn btn--red" id="projects-cta-btn">
        Consultar un proyecto similar →
      </a>
    </div>
  </div>
</section>
