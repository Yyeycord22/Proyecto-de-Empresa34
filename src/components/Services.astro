---
// src/components/Services.astro
import { services, WHATSAPP_NUMBER } from '../data/services';
---

<section class="services" id="servicios" aria-labelledby="services-title">
  <div class="container">
    <div class="section-head reveal">
      <span class="label">NUESTROS SERVICIOS</span>
      <div class="section-head__row">
        <h2 class="section-head__title" id="services-title">Soluciones visuales para cada necesidad.</h2>
        <div class="bauhaus-dots" aria-hidden="true">
          <span style="background:var(--red)"></span>
          <span style="background:var(--yellow)"></span>
          <span style="background:var(--blue)"></span>
        </div>
      </div>
    </div>
    
    <div class="services__grid">
      {services.map((service) => {
        const waLink = `https://wa.me/${WHATSAPP_NUMBER}?text=${service.buttonMessage}`;
        return (
          <article class="service-card reveal" aria-labelledby={`srv-${service.id}-title`}>
            <div class="service-card__img-wrap">
              <img 
                src={service.image} 
                alt={service.imageAlt} 
                class="service-card__img" 
                loading="lazy" 
              />
              <span class="service-card__num" style={`color:${service.numberColor}`}>
                {service.number}
              </span>
            </div>
            <div class="service-card__body">
              <h3 class="service-card__title" id={`srv-${service.id}-title`}>
                {service.title}
              </h3>
              <ul class="service-card__list">
                {service.features.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
              <a 
                href={waLink} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="service-card__btn" 
                id={`srv-${service.id}-btn`}
                aria-label={`${service.buttonText} para ${service.title}`}
              >
                {service.buttonText}
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
