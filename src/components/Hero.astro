---
// src/components/Hero.astro
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <!-- Fondo con Fotografía Principal y Overlay Suave -->
  <div class="hero__bg">
    <img 
      src="/imagenes/dbf740b7-4147-45c8-8663-60e345891e77.jpg" 
      alt="Fotografía profesional para parejas y eventos al aire libre — HAUS COMMUNITY" 
      class="hero__img" 
    />
    <div class="hero__overlay" aria-hidden="true"></div>
  </div>

  <!-- Formas Geométricas Bauhaus con Animación Sutil y Elegante -->
  <div class="hero__geo" aria-hidden="true">
    <div class="hero__geo-circle"></div>
    <div class="hero__geo-rect"></div>
    <div class="hero__geo-square"></div>
  </div>

  <!-- Contenedor Principal con Glassmorphism y Tipografía Editorial -->
  <div class="container hero__content">
    <div class="hero__badge">
      <span class="hero__badge-dot"></span>
      <span class="hero__label">FOTOGRAFÍA · VIDEO · ESTRATEGIA VISUAL</span>
    </div>

    <h1 class="hero__title" id="hero-title">
      Momentos únicos,<br />
      proyectos para <span class="text--yellow">siempre.</span>
    </h1>

    <p class="hero__desc">
      Creamos contenido visual personalizado que potencia tu marca, negocio e historias en Mindo, Los Bancos y más allá.
    </p>

    <div class="hero__actions">
      <button 
        type="button" 
        class="btn btn--red hero__btn open-contact-modal-btn" 
        id="hero-cta-btn"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        <span>Solicita una cotización</span>
      </button>

      <a href="#portafolio" class="btn btn--glass hero__btn-secondary">
        <span>Ver portafolio</span>
        <span>↓</span>
      </a>
    </div>

    <p class="hero__sub">
      Estudio profesional · Empresas · Hoteles & Spa · Gimnasios · Producción con Dron
    </p>

    <div class="hero__brand-tag">
      <span>HAUS COMMUNITY</span>
      <span>ESTUDIO CREATIVO</span>
    </div>
  </div>
</section>
