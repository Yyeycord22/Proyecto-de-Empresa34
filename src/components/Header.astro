---
// src/components/Header.astro
const navItems = [
  { href: '#inicio', label: 'Inicio', section: 'inicio' },
  { href: '#servicios', label: 'Servicios', section: 'servicios' },
  { href: '#portafolio', label: 'Portafolio', section: 'portafolio' },
  { href: '#proyectos', label: 'Proyectos', section: 'proyectos' },
  { href: '#paquetes', label: 'Paquetes', section: 'paquetes' },
  { href: '#nosotros', label: 'Sobre nosotros', section: 'nosotros' },
  { href: '#contacto', label: 'Contacto', section: 'contacto' },
];
---

<header class="header" id="header" role="banner">
  <div class="header__inner">
    <!-- Logotipo Oficial Limpio y Alineado -->
    <a href="#inicio" class="header__logo" aria-label="HAUS COMMUNITY FOTOGRAFÍA - Inicio">
      <div class="header__brand-lockup">
        <img 
          src="/imagenes/592403512_18033143426770155_1529202580814031402_n.jpg" 
          alt="HAUS COMMUNITY FOTOGRAFÍA - Logotipo Oficial" 
          class="header__logo-img" 
        />
        <div class="header__brand-text">
          <span class="header__brand-title">HAUS <strong>COMMUNITY</strong></span>
          <span class="header__brand-subtitle">FOTOGRAFÍA & VIDEO</span>
        </div>
      </div>
    </a>

    <!-- Navegación de Escritorio -->
    <nav class="header__nav" role="navigation" aria-label="Navegación principal">
      <ul class="header__nav-list">
        {navItems.map(item => (
          <li>
            <a href={item.href} class="header__nav-link" data-section={item.section}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Botón Elegante de Múltiples Canales de Contacto -->
    <button 
      type="button" 
      class="btn btn--contact header__contact-btn open-contact-modal-btn" 
      id="header-contact-btn" 
      aria-label="Abrir canales de contacto"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
      </svg>
      <span>Contactar</span>
    </button>

    <!-- Botón Menú Hamburguesa Móvil -->
    <button class="header__menu-btn" id="menu-toggle" aria-label="Abrir menú de navegación" aria-expanded="false" aria-controls="mobile-menu">
      <span class="header__menu-bar"></span>
      <span class="header__menu-bar"></span>
      <span class="header__menu-bar"></span>
    </button>
  </div>

  <!-- Menú Desplegable Móvil -->
  <div class="header__mobile-menu" id="mobile-menu" role="dialog" aria-label="Menú móvil" aria-hidden="true">
    <ul class="header__mobile-list">
      {navItems.map(item => (
        <li><a href={item.href} class="header__mobile-link">{item.label}</a></li>
      ))}
      <li style="margin-top: 1.5rem;">
        <button type="button" class="btn btn--red header__mobile-cta open-contact-modal-btn" style="width: 100%; justify-content: center;">
          Contactar ahora
        </button>
      </li>
    </ul>
  </div>
</header>
