---
// src/components/Footer.astro
import { INSTAGRAM_URL } from '../data/services';

const githubRepoUrl = 'https://github.com/Yyeycord22/Proyecto-de-Empresa34';
const currentYear = 2026;
---

<footer class="footer" role="contentinfo">
  <div class="container footer__inner">
    <!-- Marca y Logotipo Oficial -->
    <div class="footer__brand">
      <div class="footer__brand-lockup">
        <img 
          src="/imagenes/592403512_18033143426770155_1529202580814031402_n.jpg" 
          alt="HAUS COMMUNITY FOTOGRAFÍA" 
          class="footer__logo-img" 
        />
        <div class="footer__brand-meta">
          <span class="footer__brand-name">HAUS <strong>COMMUNITY</strong></span>
          <span class="footer__brand-sub">FOTOGRAFÍA & PRODUCCIÓN</span>
        </div>
      </div>
      <p class="footer__tagline">Capturamos ideas. Construimos marcas con identidad visual Bauhaus.</p>
      
      <!-- Redes y Repositorio Oficial -->
      <div class="footer__social">
        <a 
          href={INSTAGRAM_URL} 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label="Instagram oficial @haus_cm" 
          class="footer__social-link" 
          id="footer-instagram-link"
          title="Instagram @haus_cm"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>

        <!-- Enlace a GitHub Oficial -->
        <a 
          href={githubRepoUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label="Repositorio de GitHub Oficial" 
          class="footer__social-link" 
          id="footer-github-link"
          title="Repositorio GitHub oficial"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
        </a>

        <!-- Botón para desplegar canales de contacto -->
        <button 
          type="button" 
          class="footer__social-link open-contact-modal-btn" 
          aria-label="Abrir opciones de contacto"
          title="Contactar al estudio"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Navegación -->
    <nav class="footer__nav" aria-label="Navegación del pie de página">
      <strong class="footer__nav-title">SECCIONES</strong>
      <ul>
        <li><a href="#inicio">Inicio</a></li>
        <li><a href="#servicios">Servicios</a></li>
        <li><a href="#portafolio">Portafolio</a></li>
        <li><a href="#proyectos">Proyectos</a></li>
        <li><a href="#paquetes">Paquetes</a></li>
        <li><a href="#nosotros">Sobre nosotros</a></li>
        <li><a href="#contacto">Contacto</a></li>
      </ul>
    </nav>

    <!-- Lista de Servicios -->
    <div class="footer__services">
      <strong class="footer__nav-title">SERVICIOS</strong>
      <ul>
        <li>Fotografía de estudio</li>
        <li>Fotografía y video comercial</li>
        <li>Contenido digital & redes</li>
        <li>Fotografía con dron</li>
        <li>Producción audiovisual</li>
      </ul>
    </div>

    <!-- Detalles Bauhaus -->
    <div class="footer__geo" aria-hidden="true">
      <div class="footer__geo-red"></div>
      <div class="footer__geo-yellow"></div>
      <div class="footer__geo-blue"></div>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p>&copy; {currentYear} HAUS COMMUNITY FOTOGRAFÍA. Todos los derechos reservados.</p>
      <p>
        <a href={githubRepoUrl} target="_blank" rel="noopener noreferrer" style="color:var(--yellow);text-decoration:underline">
          GitHub: Proyecto-de-Empresa34
        </a> · Mindo y Los Bancos, Ecuador
      </p>
    </div>
  </div>
</footer>

<!-- Acceso directo al Panel de Administración -->
<a href="/admin" class="admin-fab" id="admin-fab-btn" title="Panel de administración (administrador / 3344K)" aria-label="Abrir panel de administración">
  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M12 20h9"/>
    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
  </svg>
</a>
