---
// src/components/ContactModal.astro
import { WHATSAPP_NUMBER, INSTAGRAM_URL } from '../data/services';

const waLink = `https://wa.me/${WHATSAPP_NUMBER}?text=Hola%2C%20vi%20su%20p%C3%A1gina%20web%20y%20quisiera%20recibir%20asesoramiento%20y%20cotizaci%C3%B3n%20para%20un%20proyecto.`;
const phoneLink = 'tel:+593999999999';
---

<div 
  class="contact-modal" 
  id="contact-modal" 
  role="dialog" 
  aria-modal="true" 
  aria-labelledby="contact-modal-title" 
  aria-hidden="true"
>
  <div class="contact-modal__overlay" id="contact-modal-overlay"></div>
  
  <div class="contact-modal__dialog">
    <button 
      type="button" 
      class="contact-modal__close" 
      id="contact-modal-close" 
      aria-label="Cerrar ventana de contacto"
    >
      &times;
    </button>

    <div class="contact-modal__header">
      <span class="label">COMUNICACIÓN DIRECTA</span>
      <h3 class="contact-modal__title" id="contact-modal-title">Elige tu canal de contacto</h3>
      <p class="contact-modal__subtitle">
        Estamos listos para escuchar tu idea y brindarte una propuesta personalizada.
      </p>
    </div>

    <div class="contact-modal__channels">
      <!-- Opción 1: WhatsApp -->
      <a 
        href={waLink} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="contact-channel contact-channel--whatsapp"
        id="channel-whatsapp"
      >
        <div class="contact-channel__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
        </div>
        <div class="contact-channel__body">
          <strong class="contact-channel__title">WhatsApp Directo</strong>
          <p class="contact-channel__desc">Mensaje instantáneo para cotizaciones y asesoría</p>
        </div>
        <span class="contact-channel__arrow">→</span>
      </a>

      <!-- Opción 2: Instagram Oficial -->
      <a 
        href={INSTAGRAM_URL} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="contact-channel contact-channel--instagram"
        id="channel-instagram"
      >
        <div class="contact-channel__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </div>
        <div class="contact-channel__body">
          <strong class="contact-channel__title">Instagram Oficial</strong>
          <p class="contact-channel__desc">Visita @haus_cm y mira nuestro trabajo en vivo</p>
        </div>
        <span class="contact-channel__arrow">→</span>
      </a>

      <!-- Opción 3: Llamada Telefónica Directa -->
      <a 
        href={phoneLink} 
        class="contact-channel contact-channel--phone"
        id="channel-phone"
      >
        <div class="contact-channel__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </div>
        <div class="contact-channel__body">
          <strong class="contact-channel__title">Llamada Telefónica</strong>
          <p class="contact-channel__desc">Conversación directa con nuestro equipo de producción</p>
        </div>
        <span class="contact-channel__arrow">→</span>
      </a>
    </div>

    <div class="contact-modal__footer">
      <span class="contact-modal__tag">Mindo & Los Bancos, Ecuador</span>
      <div class="bauhaus-dots" aria-hidden="true">
        <span style="background:var(--red); width:8px; height:8px"></span>
        <span style="background:var(--yellow); width:8px; height:8px"></span>
        <span style="background:var(--blue); width:8px; height:8px"></span>
      </div>
    </div>
  </div>
</div>
